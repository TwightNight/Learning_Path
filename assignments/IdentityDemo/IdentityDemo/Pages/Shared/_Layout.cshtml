<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - IdentityDemo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">IdentityDemo</a>
            <div class="ms-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-white me-3">Xin chào, @User.Identity.Name</span>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-sm btn-outline-warning me-2" href="/Admin">Admin</a>
                    }
                    <form method="post" asp-page="/Logout" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-light">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-light me-2" href="/Login">Đăng nhập</a>
                    <a class="btn btn-sm btn-light" href="/Register">Đăng ký</a>
                }
            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
